[Unit]
Description=chesscan analysis server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run as a dedicated user, not root. Create it with:
#   useradd --system --create-home --shell /usr/sbin/nologin chesscan
User=chesscan
WorkingDirectory=/opt/chesscan
ExecStart=/opt/chesscan/chesscan-server
Restart=on-failure
RestartSec=2
Environment=PORT=8787
Environment=CHESSCAN_TOKEN=
Environment=CHESSCAN_MAX_JOBS=2
Environment=CHESSCAN_SOLVER_PIECES=6
# Hardening: the service only needs to read its own binary and write nothing.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=

[Install]
WantedBy=multi-user.target
