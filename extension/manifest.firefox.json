{
  "manifest_version": 3,
  "name": "chesscan",
  "version": "0.1.0",
  "description": "Local Stockfish analysis for the board you are looking at on chess.com.",
  "permissions": ["storage", "http://localhost/*", "http://127.0.0.1/*", "https://*/*"],
  "background": { "scripts": ["dist/background.js"] },
  "content_scripts": [
    {
      "matches": ["https://chess.com/*", "https://*.chess.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "chesscan@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}