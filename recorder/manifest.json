{
  "manifest_version": 3,
  "name": "chesscan recorder",
  "version": "0.1.0",
  "description": "Record a chess.com tab without the chesscan arrow or panel in the video.",
  "permissions": ["activeTab", "tabCapture", "offscreen", "downloads", "storage"],
  "host_permissions": ["https://chess.com/*", "https://*.chess.com/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": {
    "default_title": "Record this chess.com tab",
    "default_popup": "src/popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+E" },
      "description": "Open the recorder popup"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://chess.com/*", "https://*.chess.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
